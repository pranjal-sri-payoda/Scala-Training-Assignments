# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# ===========================
# AUTH
# ===========================
POST    /api/login                     controllers.AuthController.login

# Customer APIs
GET   /customer/:id                   controllers.CustomerController.getCustomer(id: Long)

# Household APIs
GET   /household/:id/recentReadings   controllers.HouseholdController.getRecentReadings(id: Long, limit: Int ?= 50)
GET   /household/:id/dailyUsage       controllers.HouseholdController.getDailyUsage(id: Long)
GET   /household/:id/billing          controllers.HouseholdController.getBillingHistory(id: Long)
